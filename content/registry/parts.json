  "entries": [
    {"id": "rope_mainsheet", "kind": "rope", "phase": 1, "names": {"en": "Mainsheet", "ru": "гика-шкот"}, "aliases": {"en": ["main sheet", "German mainsheet"], "ru": ["грота-шкот", "шкот грота"]}, "boatLabel": ["Main sheet", "MAIN SHEET"], "short": {"en": "Controls how far the boom (and mainsail) can swing out. On the reference boat it is one rope with two ends, one on each side of the cockpit. Three blocks on the boom, two spring-mounted blocks on the coachroof."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-a", "photo:clutch-bank-b", "photo:mainsheet"]},
    {"id": "rope_jib_sheet", "kind": "rope", "phase": 1, "names": {"en": "Jib sheet", "ru": "стаксель-шкот"}, "aliases": {"en": ["genoa sheet", "headsail sheet"], "ru": ["шкот стакселя", "шкот генуи"]}, "boatLabel": ["Genoa sheet"], "short": {"en": "Controls the angle of the self-tacking jib. Labelled 'Genoa sheet' on the reference boat, but the sail is a self-tacking jib with a single sheet. Two rope parts between the sail and the car, so it pulls twice as hard."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-a", "brochure", "photo:track"]},
    {"id": "rope_vang", "kind": "rope", "phase": 1, "names": {"en": "Vang", "ru": "оттяжка гика"}, "aliases": {"en": ["kicker", "boom vang", "kicking strap"], "ru": ["кикер", "оттяжка"]}, "boatLabel": ["Vang"], "short": {"en": "Pulls the boom down. On the reference boat it is a rope tackle along a rigid strut (Selden Rodkicker) whose spring also holds the boom up. Controls twist in the top of the mainsail."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-b", "sailingworld:vang", "brochure", "photo:vang", "owner"]},
    {"id": "rope_topping_lift", "kind": "rope", "phase": 1, "names": {"en": "Topping lift", "ru": "топенант гика"}, "aliases": {"en": ["boom lift"], "ru": ["топенант"]}, "boatLabel": ["Boom lift"], "short": {"en": "Holds the end of the boom up from the top of the mast. Usually eased while sailing so it does not fight the vang."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-b", "photo:mainsheet"]},
    {"id": "rope_outhaul", "kind": "rope", "phase": 1, "names": {"en": "Outhaul", "ru": "оттяжка шкотового угла"}, "aliases": {"en": ["main outhaul", "clew outhaul"], "ru": ["аутхол"]}, "boatLabel": ["Main outhaul"], "short": {"en": "Pulls the mainsail's back corner out of the mast along the top of the boom. Hauled when unfurling, eased when furling."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-b", "photo:vang"]},
    {"id": "rope_main_furling_line", "kind": "rope", "phase": 1, "names": {"en": "Main furling line", "ru": "закруточный конец грота"}, "aliases": {"en": ["furling line", "in-mast furling line"], "ru": ["линь закрутки грота"]}, "boatLabel": ["Main furling"], "short": {"en": "Turns the drum at the foot of the mast that rolls the mainsail in or out. Two clutches: one line furls, the other unfurls. Backup: a winch handle in the gearbox at the mast."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-a", "photo:mast", "owner"]},
    {"id": "rope_jib_furling_line", "kind": "rope", "phase": 1, "names": {"en": "Jib furling line", "ru": "закруточный конец стакселя"}, "aliases": {"en": ["furling line", "roller furling line", "jib roll"], "ru": ["линь закрутки стакселя"]}, "boatLabel": ["JIB ROLL"], "short": {"en": "Rolls the jib around the forestay. Runs from the drum at the bow along the port side deck to its clutch. Haul it to furl (ease the jib sheet at the same time), ease it to unfurl."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:jib-roll", "brochure", "photo:bow", "photo:side-deck"]},
    {"id": "rope_main_halyard", "kind": "rope", "phase": 1, "names": {"en": "Main halyard", "ru": "грота-фал"}, "aliases": {"en": [], "ru": ["фал грота"]}, "boatLabel": ["Main halyard"], "short": {"en": "Hoists the mainsail. With in-mast furling it normally stays up; not adjusted while sailing."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-a"]},
    {"id": "rope_spi_halyard", "kind": "rope", "phase": 1, "names": {"en": "Gennaker halyard", "ru": "фал генакера"}, "aliases": {"en": ["spinnaker halyard", "spi halyard"], "ru": ["спинакер-фал"]}, "boatLabel": ["SPI HALYARD"], "short": {"en": "Hoists the big downwind sail (gennaker/spinnaker). Not used on the reference boat: no gennaker rigged."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-b", "brochure"]},
    {"id": "part_hull", "kind": "part", "phase": 1, "names": {"en": "Hull", "ru": "корпус"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The body of the boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_bow", "kind": "part", "phase": 1, "names": {"en": "Bow", "ru": "нос"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The front of the boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_stern", "kind": "part", "phase": 1, "names": {"en": "Stern", "ru": "корма"}, "aliases": {"en": ["transom (the flat back)"], "ru": ["транец"]}, "short": {"en": "The back of the boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_deck", "kind": "part", "phase": 1, "names": {"en": "Deck", "ru": "палуба"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The top surface of the hull you walk on."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_coachroof", "kind": "part", "phase": 1, "names": {"en": "Coachroof", "ru": "рубка"}, "aliases": {"en": ["cabin top", "deckhouse"], "ru": []}, "short": {"en": "The raised roof over the cabin, in front of the cockpit. The mast stands on it."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "part_cockpit", "kind": "part", "phase": 1, "names": {"en": "Cockpit", "ru": "кокпит"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The open area at the back where the crew sits, steers and handles the ropes."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_companionway", "kind": "part", "phase": 1, "names": {"en": "Companionway", "ru": "сходной люк"}, "aliases": {"en": ["hatch to the cabin"], "ru": ["вход в каюту"]}, "short": {"en": "The entrance and steps from the cockpit down into the cabin."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_keel", "kind": "part", "phase": 1, "names": {"en": "Keel", "ru": "киль"}, "aliases": {"en": ["L-keel"], "ru": ["фальшкиль"]}, "short": {"en": "Heavy fin under the boat. Stops the boat sliding sideways and keeps it upright. Draft 2.40 m."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "part_rudder", "kind": "part", "phase": 1, "names": {"en": "Rudder", "ru": "перо руля"}, "aliases": {"en": [], "ru": ["руль"]}, "short": {"en": "Underwater blade at the stern that steers the boat. Turned by the wheels."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_saildrive", "kind": "part", "phase": 2, "names": {"en": "Saildrive and propeller", "ru": "saildrive и гребной винт"}, "aliases": {"en": [], "ru": ["винт"]}, "short": {"en": "The engine's leg and 2-blade propeller under the hull."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "part_lifelines", "kind": "part", "phase": 1, "names": {"en": "Lifelines and stanchions", "ru": "леера и леерные стойки"}, "aliases": {"en": ["railing"], "ru": []}, "short": {"en": "Safety wires around the deck held by vertical posts."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "env_water", "kind": "environment", "phase": 1, "names": {"en": "Water surface", "ru": "поверхность воды"}, "aliases": {"en": ["waterline level"], "ru": []}, "short": {"en": "Flat water at the boat's waterline. See-through so the keel and rudder stay visible."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_mast", "kind": "part", "phase": 1, "names": {"en": "Mast", "ru": "мачта"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Vertical spar holding the sails. On the reference boat the mainsail rolls up inside it."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "part_boom", "kind": "part", "phase": 1, "names": {"en": "Boom", "ru": "гик"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Horizontal spar along the bottom of the mainsail. Its angle is set by the wind and limited by the mainsheet. Watch your head."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_gooseneck", "kind": "part", "phase": 1, "names": {"en": "Gooseneck", "ru": "гусёк"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The hinge joining the boom to the mast."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_spreader", "kind": "part", "phase": 1, "names": {"en": "Spreaders", "ru": "краспицы"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Two sets of struts sticking out from the mast, swept back, that spread the shrouds."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:spreaders"]},
    {"id": "part_shroud", "kind": "part", "phase": 1, "names": {"en": "Shrouds", "ru": "ванты"}, "aliases": {"en": ["side stays"], "ru": []}, "short": {"en": "Wires holding the mast up from the sides. The boom cannot swing past them."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_forestay", "kind": "part", "phase": 1, "names": {"en": "Forestay", "ru": "штаг"}, "aliases": {"en": [], "ru": ["форштаг"]}, "short": {"en": "Wire from the bow to the top of the mast. The jib is rolled around it."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_backstay", "kind": "part", "phase": 1, "names": {"en": "Backstay", "ru": "ахтерштаг"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Wire from the top of the mast to the stern."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "env_wind", "kind": "environment", "phase": 1, "names": {"en": "Test wind", "ru": "тестовый ветер"}, "aliases": {"en": ["true wind (while the boat is still)"], "ru": []}, "short": {"en": "Wind set by hand in the Wind tab: where it comes from and how strong. The boat does not move in this version, so this is the wind the sails feel. The light streaks show it."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_windex", "kind": "part", "phase": 1, "names": {"en": "Masthead wind indicator", "ru": "флюгер на топе мачты"}, "aliases": {"en": ["windex"], "ru": []}, "short": {"en": "Arrow at the top of the mast that points into the wind."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_main_furling_gearbox", "kind": "fitting", "phase": 1, "names": {"en": "In-mast furling gearbox", "ru": "редуктор закрутки грота"}, "aliases": {"en": ["furling drum"], "ru": []}, "short": {"en": "Drum and gearbox at the foot of the mast for the main furling line. A winch handle fits in it as a backup (IN/OUT arrow)."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:mast"]},
    {"id": "part_jib_furler", "kind": "fitting", "phase": 1, "names": {"en": "Jib furler", "ru": "закрутка стакселя"}, "aliases": {"en": ["roller furler", "furling drum"], "ru": ["ролерфорлинг"]}, "short": {"en": "Drum at the bottom of the forestay that rolls the jib up (Selden Furlex 404S on the reference boat)."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["brochure", "photo:bow"]},
    {"id": "sail_main", "kind": "sail", "phase": 1, "names": {"en": "Mainsail", "ru": "грот"}, "aliases": {"en": ["main"], "ru": []}, "short": {"en": "The sail behind the mast, attached to the boom. Rolls into the mast on the reference boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "sail_jib", "kind": "sail", "phase": 1, "names": {"en": "Self-tacking jib", "ru": "самоповоротный стаксель"}, "aliases": {"en": ["jib", "headsail"], "ru": ["стаксель"]}, "short": {"en": "The sail in front of the mast. Its sheet runs to a car on a straight track in front of the mast, so it changes sides by itself when tacking."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["brochure", "boatingnz:hanse508"]},
    {"id": "sail_gennaker", "kind": "sail", "phase": 99, "names": {"en": "Gennaker", "ru": "генакер"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Large light downwind sail. Brochure option, not rigged on the reference boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "sailpart_head", "kind": "sailpart", "phase": 4, "names": {"en": "Head", "ru": "фаловый угол"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Top corner of a sail."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "sailpart_tack", "kind": "sailpart", "phase": 4, "names": {"en": "Tack (corner)", "ru": "галсовый угол"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Front lower corner of a sail. Careful: 'tack' also means a manoeuvre and a side the wind comes from."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "sailpart_clew", "kind": "sailpart", "phase": 4, "names": {"en": "Clew", "ru": "шкотовый угол"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Back lower corner of a sail, where the sheet pulls."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "sailpart_luff", "kind": "sailpart", "phase": 4, "names": {"en": "Luff", "ru": "передняя шкаторина"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Front edge of a sail. 'Luffing' means the sail flaps from this edge."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "sailpart_leech", "kind": "sailpart", "phase": 4, "names": {"en": "Leech", "ru": "задняя шкаторина"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Back edge of a sail."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "sailpart_foot", "kind": "sailpart", "phase": 4, "names": {"en": "Foot", "ru": "нижняя шкаторина"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Bottom edge of a sail."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "fit_mainsheet_boom_blocks", "kind": "fitting", "phase": 1, "names": {"en": "Mainsheet blocks on the boom", "ru": "блоки гика-шкота на гике"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Three pulleys under the middle of the boom the mainsheet runs through."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:mainsheet"]},
    {"id": "fit_mainsheet_deck_blocks", "kind": "fitting", "phase": 1, "names": {"en": "Mainsheet deck blocks", "ru": "палубные блоки гика-шкота"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Two spring-mounted pulleys on the back of the coachroof, one each side. The German mainsheet runs from one, up to the boom and down to the other."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:mainsheet"]},
    {"id": "fit_self_tacking_track", "kind": "fitting", "phase": 1, "names": {"en": "Self-tacking track", "ru": "погон самоповоротного стакселя"}, "aliases": {"en": ["jib track"], "ru": ["погон стакселя"]}, "short": {"en": "Straight rail across the deck just in front of the mast. The jib sheet car slides along it."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["brochure", "photo:track"]},
    {"id": "fit_self_tacking_car", "kind": "fitting", "phase": 1, "names": {"en": "Jib car", "ru": "каретка стакселя"}, "aliases": {"en": ["track car", "traveller car"], "ru": ["ползун"]}, "short": {"en": "Slider on the self-tacking track. The jib sheet runs through it; it slides to the leeward side by itself."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "fit_clutch", "kind": "fitting", "phase": 1, "names": {"en": "Rope clutch", "ru": "стопор"}, "aliases": {"en": ["jammer", "clutch"], "ru": ["стопор фалов и шкотов"]}, "short": {"en": "Lever that locks a rope so it does not need to stay on a winch. Open it only when the rope is on a winch or not loaded."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "clutch_bank_a", "kind": "fitting", "phase": 1, "names": {"en": "Clutch bank A", "ru": "блок стопоров A"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Main sheet, Main furling x2, Main halyard, Genoa sheet. Starboard side, in front of the winch."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-a", "owner"]},
    {"id": "clutch_bank_b", "kind": "fitting", "phase": 1, "names": {"en": "Clutch bank B", "ru": "блок стопоров B"}, "aliases": {"en": [], "ru": []}, "short": {"en": "SPI halyard, Boom lift, Main outhaul, MAIN SHEET, Vang. Port side, in front of the winch."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:clutch-bank-b", "owner"]},
    {"id": "clutch_jib_roll", "kind": "fitting", "phase": 1, "names": {"en": "Jib furling clutch", "ru": "стопор закрутки стакселя"}, "aliases": {"en": [], "ru": []}, "boatLabel": ["JIB ROLL"], "short": {"en": "Single clutch on the port side deck next to the sprayhood, for the jib furling line."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:jib-roll", "photo:side-deck"]},
    {"id": "fit_winch", "kind": "fitting", "phase": 1, "names": {"en": "Winch", "ru": "лебёдка"}, "aliases": {"en": ["self-tailing winch"], "ru": ["шпиль (разг.)"]}, "short": {"en": "Drum turned with a handle to pull a loaded rope. The reference boat has Lewmar 55 self-tailing winches by the wheels."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["brochure", "photo:cockpit"]},
    {"id": "winch_primary_port", "kind": "fitting", "phase": 1, "names": {"en": "Port winch", "ru": "левая лебёдка"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Winch on the port side by the wheel."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure", "photo:cockpit"]},
    {"id": "winch_primary_starboard", "kind": "fitting", "phase": 1, "names": {"en": "Starboard winch", "ru": "правая лебёдка"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Winch on the starboard side by the wheel."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure", "photo:cockpit"]},
    {"id": "part_winch_handle", "kind": "fitting", "phase": 1, "names": {"en": "Winch handle", "ru": "ручка лебёдки"}, "aliases": {"en": ["handle"], "ru": ["рукоятка лебёдки"]}, "short": {"en": "The one crank handle on board. It fits the socket of the furling gearbox at the mast (to roll the main in by hand) and the top of each winch (a backup for the electric motor)."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["owner", "photo:mast"]},
    {"id": "winch_secondary_port", "kind": "fitting", "phase": 1, "names": {"en": "Port secondary winch (optional)", "ru": "дополнительная левая лебёдка"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Optional extra winch from the brochure. Not on the reference boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "winch_secondary_starboard", "kind": "fitting", "phase": 1, "names": {"en": "Starboard secondary winch (optional)", "ru": "дополнительная правая лебёдка"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Optional extra winch from the brochure. Not on the reference boat."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "helm_port", "kind": "fitting", "phase": 1, "names": {"en": "Port wheel", "ru": "левый штурвал"}, "aliases": {"en": ["helm"], "ru": []}, "short": {"en": "One of two steering wheels. Both turn the same rudder."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "helm_starboard", "kind": "fitting", "phase": 1, "names": {"en": "Starboard wheel", "ru": "правый штурвал"}, "aliases": {"en": ["helm"], "ru": []}, "short": {"en": "One of two steering wheels. Both turn the same rudder."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "fit_compass", "kind": "fitting", "phase": 2, "names": {"en": "Compass", "ru": "компас"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Illuminated compass at each wheel."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["brochure"]},
    {"id": "engine_control", "kind": "fitting", "phase": 2, "names": {"en": "Engine control lever", "ru": "рукоятка газ-реверс"}, "aliases": {"en": ["throttle", "single-lever control"], "ru": ["ручка газа"]}, "short": {"en": "One lever for gear and throttle: forward = ahead, middle = neutral, back = astern. A sticker limits it to 2500 rpm."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:engine"]},
    {"id": "term_sheet", "kind": "term", "phase": 4, "names": {"en": "Sheet", "ru": "шкот"}, "aliases": {"en": [], "ru": []}, "short": {"en": "A rope that controls the angle of a sail. Not a sail itself."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_halyard", "kind": "term", "phase": 4, "names": {"en": "Halyard", "ru": "фал"}, "aliases": {"en": [], "ru": []}, "short": {"en": "A rope that pulls a sail up."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_port", "kind": "term", "phase": 4, "names": {"en": "Port", "ru": "левый борт"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Left side when facing the bow."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_starboard", "kind": "term", "phase": 4, "names": {"en": "Starboard", "ru": "правый борт"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Right side when facing the bow."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_windward", "kind": "term", "phase": 4, "names": {"en": "Windward", "ru": "наветренный"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The side the wind comes from."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_leeward", "kind": "term", "phase": 4, "names": {"en": "Leeward", "ru": "подветренный"}, "aliases": {"en": [], "ru": []}, "short": {"en": "The side the wind blows towards. The boom is on the leeward side."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_true_wind", "kind": "term", "phase": 2, "names": {"en": "True wind", "ru": "истинный ветер"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Wind as felt by a boat that is not moving."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_apparent_wind", "kind": "term", "phase": 2, "names": {"en": "Apparent wind", "ru": "вымпельный ветер"}, "aliases": {"en": [], "ru": ["кажущийся ветер"]}, "short": {"en": "Wind as felt on the moving boat: true wind plus the wind from the boat's own motion. This is what the sails feel."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_starboard_tack", "kind": "term", "phase": 4, "names": {"en": "Starboard tack", "ru": "правый галс"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Sailing with the wind coming over the starboard side (boom on the port side)."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_port_tack", "kind": "term", "phase": 4, "names": {"en": "Port tack", "ru": "левый галс"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Sailing with the wind coming over the port side (boom on the starboard side)."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_tacking", "kind": "term", "phase": 4, "names": {"en": "Tacking", "ru": "поворот оверштаг"}, "aliases": {"en": ["going about"], "ru": []}, "short": {"en": "Turning the bow through the wind so the wind comes from the other side."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_gybe", "kind": "term", "phase": 4, "names": {"en": "Gybe", "ru": "поворот фордевинд"}, "aliases": {"en": ["jibe"], "ru": []}, "short": {"en": "Turning the stern through the wind. The boom swings across the whole boat; uncontrolled it is dangerous."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_luffing", "kind": "term", "phase": 1, "names": {"en": "Luffing (sail flapping)", "ru": "заполаскивание"}, "aliases": {"en": [], "ru": ["парус полощет"]}, "short": {"en": "The sail flaps because it is aligned with the wind and not filled. Sheet in a little, or bear away."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_ease", "kind": "term", "phase": 1, "names": {"en": "Ease", "ru": "потравить"}, "aliases": {"en": ["let out"], "ru": ["травить"]}, "short": {"en": "Let a rope out."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_trim", "kind": "term", "phase": 1, "names": {"en": "Trim / haul in", "ru": "выбрать"}, "aliases": {"en": ["sheet in", "pull in"], "ru": ["подобрать", "добрать"]}, "short": {"en": "Pull a rope in."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_twist", "kind": "term", "phase": 1, "names": {"en": "Twist", "ru": "твист"}, "aliases": {"en": [], "ru": ["скрутка паруса"]}, "short": {"en": "The top of the sail opening further than the bottom. Controlled by the vang (main) and by the sheet position (jib)."}, "status": {"en": "draft", "ru": "draft"}, "sources": ["sailingworld:vang"]},
    {"id": "term_telltale", "kind": "term", "phase": 2, "names": {"en": "Telltales", "ru": "колдунчики"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Short strips of yarn on the sails that show the airflow."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_no_go_zone", "kind": "term", "phase": 2, "names": {"en": "No-go zone", "ru": "мёртвая зона (левентик)"}, "aliases": {"en": ["in irons"], "ru": ["левентик"]}, "short": {"en": "About 45 degrees either side of the wind. A sailing boat cannot sail there."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_close_hauled", "kind": "term", "phase": 2, "names": {"en": "Close-hauled", "ru": "бейдевинд"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Sailing as close to the wind as possible, sails trimmed in."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_beam_reach", "kind": "term", "phase": 2, "names": {"en": "Beam reach", "ru": "галфвинд"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Wind from the side, 90 degrees."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_broad_reach", "kind": "term", "phase": 2, "names": {"en": "Broad reach", "ru": "бакштаг"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Wind from behind the side, sails eased well out."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_run", "kind": "term", "phase": 2, "names": {"en": "Running", "ru": "фордевинд"}, "aliases": {"en": ["dead run"], "ru": []}, "short": {"en": "Wind from directly behind. Risk of an accidental gybe."}, "status": {"en": "source-checked", "ru": "draft"}, "sources": ["wiki:point-of-sail"]},
    {"id": "term_reef", "kind": "term", "phase": 4, "names": {"en": "Reefing", "ru": "брать рифы"}, "aliases": {"en": ["furling away"], "ru": []}, "short": {"en": "Making a sail smaller for stronger wind. On the reference boat: partly furl the main and/or the jib."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "term_preventer", "kind": "term", "phase": 2, "names": {"en": "Preventer", "ru": "завал-тали"}, "aliases": {"en": [], "ru": ["превентер"]}, "short": {"en": "A rope that stops the boom from swinging across in an accidental gybe."}, "status": {"en": "draft", "ru": "draft"}, "sources": []},
    {"id": "part_vang_strut", "kind": "part", "phase": 1, "names": {"en": "Rigid vang strut", "ru": "жёсткая оттяжка гика"}, "aliases": {"en": ["Rodkicker", "rigid kicker"], "ru": ["ригидный кикер"]}, "short": {"en": "Telescopic strut from the mast foot to the boom. Its gas spring holds the boom up; its rope tackle pulls it down."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:vang"]},
    {"id": "fit_mast_base_turning_blocks", "kind": "fitting", "phase": 1, "names": {"en": "Turning blocks at the mast foot", "ru": "отводные блоки у основания мачты"}, "aliases": {"en": ["deck organiser"], "ru": []}, "short": {"en": "Ring of pulleys at the foot of the mast where halyards and control lines turn and run aft to the cockpit."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:mast-base"]},
    {"id":  "fit_line_channels", "kind":  "fitting", "phase":  1, "names":  {"en":  "Line channels", "ru":  "закрытые каналы для концов"}, "aliases":  {"en":  ["covered line channels", "line covers"], "ru":  []}, "short":  {"en":  "Low covers on the coachroof and the cockpit coamings. The control lines run underneath them from the turning blocks at the foot of the mast to the clutches."}, "status":  {"en":  "draft", "ru":  "draft"}, "sources":  ["photo:mast-base", "photo:cockpit"]},
    {"id": "fit_sprayhood", "kind": "part", "phase": 1, "names": {"en": "Sprayhood", "ru": "козырёк кокпита"}, "aliases": {"en": ["dodger"], "ru": ["спрейхуд"]}, "short": {"en": "Fabric and window shelter at the front of the cockpit."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:mainsheet"]},
    {"id": "fit_anchor_windlass", "kind": "fitting", "phase": 5, "names": {"en": "Anchor windlass", "ru": "якорная лебёдка"}, "aliases": {"en": [], "ru": ["брашпиль"]}, "short": {"en": "Electric drum on the foredeck that lifts the anchor chain."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:bow"]},
    {"id": "fit_bow_roller", "kind": "fitting", "phase": 5, "names": {"en": "Bow roller", "ru": "носовой якорный роульс"}, "aliases": {"en": ["anchor roller"], "ru": []}, "short": {"en": "Fitting at the bow the anchor chain runs over."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:bow"]},
    {"id": "fit_mooring_cleat", "kind": "fitting", "phase": 5, "names": {"en": "Mooring cleat", "ru": "швартовная утка"}, "aliases": {"en": [], "ru": ["утка"]}, "short": {"en": "Metal fitting on deck to tie mooring lines to."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:bow"]},
    {"id": "fit_autopilot_control", "kind": "fitting", "phase": 2, "names": {"en": "Autopilot control", "ru": "пульт авторулевого"}, "aliases": {"en": ["autohelm"], "ru": []}, "short": {"en": "Buttons at the helm that let the autopilot steer."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:cockpit"]},
    {"id": "fit_instrument_display", "kind": "fitting", "phase": 2, "names": {"en": "Instrument display", "ru": "дисплей приборов"}, "aliases": {"en": [], "ru": []}, "short": {"en": "Screen at the helm showing speed, wind, depth and position."}, "status": {"en": "photo-confirmed", "ru": "draft"}, "sources": ["photo:cockpit"]}
  ]
}
